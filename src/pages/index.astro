---
import Layout from "@layouts/Layout.astro";
import Terminal from "@components/Terminal.astro";
import MeetupDetails from "@components/MeetupDetails.astro";
import Countdown from "@components/Countdown.astro";
import { Image } from "astro:assets";

import { nextMeetup, pastMeetups, startsAt, weekday } from "../data/meetups";

import logoLandscape from "@images/logo-landscape.svg";
import logoNixcademy from "@images/supporters/nixcademy.svg";
import logoApplicative from "@images/supporters/applicative.svg";
import logoNixInstitute from "@images/supporters/nix-institute.svg";

const supporters = [
  { name: "Nixcademy", href: "https://nixcademy.com", logo: logoNixcademy, class: "h-8" },
  { name: "Applicative Systems", href: "https://applicative.systems", logo: logoApplicative, class: "h-10" },
  { name: "Institute of Nix", href: "https://nix.institute", logo: logoNixInstitute, class: "h-9", wordmark: true },
];

const nextStart = startsAt(nextMeetup);

const pastSummary = (m: (typeof pastMeetups)[number]) =>
  m.title ?? m.talks?.[0]?.title ?? "Meetup";
---

<Layout title="Nix Usergroup Hannover Braunschweig Wolfsburg">
  <div class="mx-auto flex max-w-screen-md flex-col gap-12 px-4 pt-10">
    <!-- hero -->
    <section class="flex flex-col gap-6">
      <Image src={logoLandscape} alt="Nix Usergroup Hannover Braunschweig Wolfsburg" class="mx-auto w-full max-w-xl" />
      <div class="flex flex-col gap-2">
        <p class="prompt text-sm">whoami</p>
        <h1>
          Nix(OS) User Group<br />
          <span class="text-term-blue">Hannover</span> <span class="text-term-muted">·</span>
          <span class="text-term-blue">Braunschweig</span> <span class="text-term-muted">·</span>
          <span class="text-term-blue">Wolfsburg</span>
        </h1>
        <p class="comment">
          # Talks, hacking, games and food for everyone into reproducible systems and Linux.
        </p>
      </div>
    </section>

    <!-- next meetup -->
    <Terminal id="next" title="~/habrawo: nix run .#next-meetup" class="scroll-mt-20 ring-1 ring-term-green/40">
      <p class="prompt">nix run .#next-meetup</p>

      <h2 class="text-term-yellow">{nextMeetup.title}</h2>

      {nextStart && <Countdown start={nextStart} />}

      {
        nextMeetup.rsvp && (
          <p>
            <span class="font-bold text-term-yellow">warning:</span> please{" "}
            <a href="#contact">drop us a message</a> if you're coming so we can organize enough food!
          </p>
        )
      }

      {
        nextMeetup.flyer && (
          <Image
            src={nextMeetup.flyer.src}
            alt={nextMeetup.flyer.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 720px, 100vw"
            class="w-full rounded-md border border-term-border"
          />
        )
      }

      <MeetupDetails meetup={nextMeetup} />

      <p class="prompt"><span class="cursor" aria-hidden="true"></span></p>
    </Terminal>

    <!-- supporters -->
    <section class="flex flex-col gap-3">
      <h2>Supported by</h2>
      <p class="text-term-muted">These companies help make our meetups happen. Thank you!</p>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          supporters.map((s) => (
            <li>
              <a
                href={s.href}
                title={s.name}
                class="flex h-20 items-center justify-center gap-2 rounded-md border border-term-border bg-white px-4 no-underline transition-transform hover:-translate-y-0.5 hover:bg-white hover:shadow-md"
              >
                <Image src={s.logo} alt={s.wordmark ? "" : s.name} class:list={["w-auto", s.class]} />
                {s.wordmark && (
                  <span class="whitespace-nowrap text-base text-neutral-900">
                    <span class="font-bold">Institute</span> <span class="font-light">of</span>{" "}
                    <span class="font-bold text-[#5277c3]">Nix</span>
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- contact -->
    <Terminal id="contact" title="~/habrawo: cat contact.toml" class="scroll-mt-20">
      <p class="prompt">cat contact.toml</p>
      <pre class="overflow-x-auto leading-relaxed"><span class="text-term-magenta">[chat]</span>
<span class="text-term-cyan">whatsapp</span> <span class="text-term-muted">=</span> <span class="text-term-green">"<a href="https://chat.whatsapp.com/JSWO6lI7Ls5BrRxzpmYKuR" class="text-term-green">join here</a>"</span>
<span class="text-term-cyan">matrix</span>   <span class="text-term-muted">=</span> <span class="text-term-green">"<a href="https://matrix.to/#/#habrawo:nixos.org" class="text-term-green">#habrawo:nixos.org</a>"</span>

<span class="text-term-magenta">[organizer]</span>
<span class="text-term-cyan">email</span>  <span class="text-term-muted">=</span> <span class="text-term-green">"jacek@applicative.systems"</span>
<span class="text-term-cyan">matrix</span> <span class="text-term-muted">=</span> <span class="text-term-green">"<a href="https://matrix.to/#/@tfc:matrix.org" class="text-term-green">@tfc:matrix.org</a>"</span></pre>
    </Terminal>

    <!-- past meetups -->
    <section id="past" class="flex scroll-mt-20 flex-col gap-4">
      <p class="prompt">git log --oneline past-meetups</p>
      <ul class="flex flex-col divide-y divide-term-border overflow-hidden rounded-lg border border-term-border bg-term-surface">
        {
          pastMeetups.map((m) => (
            <li>
              <details class="group">
                <summary class="flex cursor-pointer list-none gap-3 px-4 py-3 hover:bg-term-raised [&::-webkit-details-marker]:hidden">
                  <span class="shrink-0 text-term-muted transition-transform group-open:rotate-90">›</span>
                  <span class="shrink-0 text-term-yellow">{m.date}</span>
                  <span class="hidden shrink-0 text-term-muted sm:inline">{weekday(m.date)}</span>
                  <span class="min-w-0 [&_a]:pointer-events-none [&_a]:text-current [&_a]:no-underline" set:html={pastSummary(m)} />
                </summary>
                <div class="flex flex-col gap-4 border-t border-dashed border-term-border px-4 py-4 sm:px-6">
                  {m.flyer && (
                    <Image
                      src={m.flyer.src}
                      alt={m.flyer.alt}
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 680px, 100vw"
                      class="w-full rounded-md border border-term-border"
                    />
                  )}
                  <MeetupDetails meetup={m} />
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

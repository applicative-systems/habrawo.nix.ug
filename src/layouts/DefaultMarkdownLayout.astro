---
const { frontmatter } = Astro.props;
import Layout from "./Layout.astro";

const file = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
---

<Layout title={frontmatter.title}>
  <div class="mx-auto flex max-w-screen-md flex-col gap-4 px-4 pt-10">
    <p class="prompt text-sm">less {file}.md</p>
    <article
      class="md-headings prose max-w-none font-mono prose-headings:font-bold prose-headings:text-term-fg prose-h2:text-xl prose-h3:text-lg prose-h3:text-term-cyan prose-p:text-term-fg prose-a:text-term-blue prose-strong:text-term-fg prose-li:text-term-fg"
    >
      <h1>{frontmatter.title}</h1>
      <slot />
    </article>
  </div>
</Layout>

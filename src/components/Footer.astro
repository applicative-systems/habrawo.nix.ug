---
const windows = [
  ["home", "/"],
  ["impressum", "/impressum"],
  ["datenschutz", "/gdpr"],
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer class="mt-12 border-t border-term-border bg-term-raised text-xs">
  <div class="mx-auto flex max-w-screen-md flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2">
    <ul class="flex flex-wrap items-center gap-x-3">
      <li class="bg-term-green px-1.5 font-bold text-term-bg">[habrawo]</li>
      {
        windows.map(([label, href], i) => {
          const active = current === href;
          return (
            <li>
              <a
                href={href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "no-underline hover:bg-transparent hover:text-term-fg",
                  active ? "font-bold text-term-green" : "text-term-muted",
                ]}
              >
                {i}:{label}
                {active && "*"}
              </a>
            </li>
          );
        })
      }
    </ul>
    <span class="text-term-muted">built with <code class="text-term-fg">nix build .#website</code></span>
  </div>
</footer>
